@article{alba_honest_2026,
	title = {Honest {Teacher} {Knowledge} {Distillation}: {A} {Framework} for {Uncertainty}-{Aware} {Model} {Compression} {Using} {Gaussian} {Processes}},
	volume = {14},
	issn = {2169-3536},
	shorttitle = {Honest {Teacher} {Knowledge} {Distillation}},
	url = {https://ieeexplore.ieee.org/document/11475401},
	doi = {10.1109/ACCESS.2026.3681278},
	abstract = {We introduce Honest Teacher Knowledge Distillation (HTKD), an uncertainty-aware distillation framework that transfers both knowledge and confidence from a teacher to a compact student by integrating Gaussian Process (GP)–based predictive uncertainty into the learning objective. Unlike conventional knowledge distillation that treats teacher outputs as uniformly reliable, HTKD explicitly models uncertainty over the teacher’s feature representations and logits, and adaptively down-weights ambiguous supervision. This enables reliability-aware knowledge transfer even in fully supervised settings, where teachers remain imperfect on visually ambiguous or rare samples. HTKD is evaluated using a ResNet- 101 {\textbackslash}to ResNet-18 teacher–student pair across datasets of varying scale—MS COCO, PASCAL VOC, and Oxford-IIIT Pet—using detection accuracy and calibration metrics. HTKD improves mAP over the non-distilled student by +4.3 on COCO, +4.5 on VOC, and +4.8 on Oxford-IIIT Pet, while achieving the lowest Expected Calibration Error and Brier Score across all datasets. A progressive loss-function ablation confirms monotonic gains from feature-only KD to the full GP-weighted formulation, along with faster and more stable convergence. Robustness is further assessed under Gaussian and motion blur corruptions, where HTKD degrades significantly slower than single-teacher KD and achieves trends comparable to multi-teacher KD, while retaining a single-teacher training cost. These results demonstrate that uncertainty-aware distillation enhances accuracy, calibration, and robustness, making HTKD suitable for reliable edge and real-world deployment.},
	urldate = {2026-09-11},
	journal = {IEEE Access},
	author = {Alba, Arjay R. and Villaverde, Jocelyn F.},
	year = {2026},
	keywords = {3G mobile communication, Artificial neural networks, Communication systems, Electronic mail, Gaussian processes, HTTP, Internet, Location awareness, Machine learning, Mobile communication, Model compression, Protocols, calibration, embedded computing, knowledge distillation, model compression, object detection, uncertainty estimation},
	pages = {56761--56778},
}

@misc{zhang_can_2024,
	title = {Can {Students} {Beyond} {The} {Teacher}? {Distilling} {Knowledge} from {Teacher}'s {Bias}},
	shorttitle = {Can {Students} {Beyond} {The} {Teacher}?},
	url = {http://arxiv.org/abs/2412.09874},
	doi = {10.48550/arXiv.2412.09874},
	abstract = {Knowledge distillation (KD) is a model compression technique that transfers knowledge from a large teacher model to a smaller student model to enhance its performance. Existing methods often assume that the student model is inherently inferior to the teacher model. However, we identify that the fundamental issue affecting student performance is the bias transferred by the teacher. Current KD frameworks transmit both right and wrong knowledge, introducing bias that misleads the student model. To address this issue, we propose a novel strategy to rectify bias and greatly improve the student model's performance. Our strategy involves three steps: First, we differentiate knowledge and design a bias elimination method to filter out biases, retaining only the right knowledge for the student model to learn. Next, we propose a bias rectification method to rectify the teacher model's wrong predictions, fundamentally addressing bias interference. The student model learns from both the right knowledge and the rectified biases, greatly improving its prediction accuracy. Additionally, we introduce a dynamic learning approach with a loss function that updates weights dynamically, allowing the student model to quickly learn right knowledge-based easy tasks initially and tackle hard tasks corresponding to biases later, greatly enhancing the student model's learning efficiency. To the best of our knowledge, this is the first strategy enabling the student model to surpass the teacher model. Experiments demonstrate that our strategy, as a plug-and-play module, is versatile across various mainstream KD frameworks. We will release our code after the paper is accepted.},
	urldate = {2026-09-11},
	publisher = {arXiv},
	author = {Zhang, Jianhua and Gao, Yi and Liu, Ruyu and Cheng, Xu and Zhang, Houxiang and Chen, Shengyong},
	month = dec,
	year = {2024},
	note = {arXiv:2412.09874 [cs.CV]},
	keywords = {Computer Science - Computer Vision and Pattern Recognition},
}

