@article{wu_well_2026,
	title = {Well path lightweight prediction model construction method for rotary steerable system based on composite knowledge distillation},
	volume = {12},
	issn = {2198-6053},
	url = {https://doi.org/10.1007/s40747-026-02321-4},
	doi = {10.1007/s40747-026-02321-4},
	abstract = {The rotary steerable system (RSS) is a critical directional drilling technology where accurate well path prediction is essential for operational precision and efficiency. Existing methods struggle to balance accuracy and model complexity: high-accuracy models are too large for downhole deployment, while lightweight models lack the accuracy required for closed-loop control. To address this, we propose a novel RSS well path prediction method combining time series forecasting (TSF) with knowledge distillation (KD). A high-precision teacher model is first constructed by integrating graph representation learning with TSF. A novel isomorphic knowledge distillation method, termed intermediate layers feature adaptive fusion supervised KD, is then employed to extract and transfer intermediate layer knowledge from the teacher. Finally, a composite distillation framework combining intermediate and output layer knowledge trains a lightweight student model, with the loss function dynamically optimized via a learnable weight allocation mechanism. The resulting student model achieves 98\% compression while maintaining high accuracy, with only a 1.3\% drop in R2 and a 16\% increase in MAE compared to the teacher, realizing high-precision, lightweight RSS well path prediction.},
	language = {en},
	number = {6},
	urldate = {2026-09-10},
	journal = {Complex \& Intelligent Systems},
	author = {Wu, Tianyu and Shi, Yucai and Xu, Lihui and Liao, Hualin and Li, Wei},
	month = apr,
	year = {2026},
	keywords = {AI for resource-constrained and complex application, Edge computing, Knowledge distillation, Rotary steerable system (RSS), Well path prediction},
	pages = {158},
}

@article{jo_cross-modal_2026,
	title = {Cross-{Modal} {Feature} {Distillation} via {Sample}-{Aware} {Adaptive} {Masking}},
	volume = {14},
	issn = {2169-3536},
	url = {https://ieeexplore.ieee.org/document/11479573/},
	doi = {10.1109/ACCESS.2026.3682780},
	abstract = {Cross-modal knowledge distillation aims to train a student model by distilling knowledge from a teacher in a different modality. When the teacher and student modalities are highly heterogeneous, directly transferring teacher features can make them difficult for the student model to interpret, as such features often contain modality-specific information. To address this issue, we propose Sample-Aware Adaptive Masking (SAAMask), a strategy that accounts for the transfer difficulty of each feature dimension. SAAMask measures the dimension-wise discrepancy between teacher and student features for each sample, using this discrepancy as an indicator of transfer difficulty. Dimensions exhibiting large discrepancies are treated as hard to transfer and are selectively suppressed during the distillation process on a per-sample basis. The proposed method can be seamlessly integrated into existing feature-alignment-based distillation frameworks, and experimental results on various benchmark datasets demonstrate that SAAMask consistently improves the performance of feature alignment-based methods.},
	urldate = {2026-09-10},
	journal = {IEEE Access},
	author = {Jo, Dae Ung and Um, Daeho},
	year = {2026},
	keywords = {Central Processing Unit, Cross-modal knowledge distillation, Filtering, Filters, MIMICs, Millimeter wave integrated circuits, Monolithic integrated circuits, Pixel, Routing, Video equipment, Videos, knowledge distillation, multi-modal classification, multi-modal learning},
	pages = {56128--56137},
}

