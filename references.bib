@article{su_medkit_2026,
	title = {{MedKit}: {Multi}-level feature distillation with knowledge injection for radiology report generation},
	volume = {296},
	issn = {0957-4174},
	shorttitle = {{MedKit}},
	url = {https://www.sciencedirect.com/science/article/pii/S095741742502620X},
	doi = {10.1016/j.eswa.2025.129003},
	abstract = {Radiology report generation automates the creation of clinically accurate and coherent paragraphs from medical images, reducing the heavy burden of report writing for radiologists. However, current research in this field still faces limitations and urgently requires breakthroughs in feature extraction of image knowledge and model fusion. In this paper, we propose a radiology report generation framework, MedKit, that integrates high information density knowledge fusion with multi-level task feature distillation. We leverage knowledge embedding fusion through a knowledge graph to reduce semantic hallucinations. Additionally, by employing feature extraction techniques within a multi-level task feature distillation architecture, comprehensive image feature information is provided for the primary task. For adapting 2D and 3D images, we propose different visual encoders respectively, which address the issue of inconsistent shapes in medical images. Finally, utilizing a multimodal large model framework enables the generated radiology report to closely approximate medical experts’ fluent expression. Our proposed model significantly outperformed the state-of-the-art model in the MIMIC-CXR dataset with a 20.1 \% increase in the BLEU-4 score, from 0.134 to 0.161. We also achieved the best result on the private Liver-CT dataset. Our code is available at https://github.com/sujaly/MedKit.},
	urldate = {2026-09-06},
	journal = {Expert Systems with Applications},
	author = {Su, Zhaoli and Song, Hong and Lin, Yucong and Wu, You and Weng, Xutao and Mao, Zhongxuan and Liu, Bowen and Yin, Hongxia and Yang, Jian},
	month = jan,
	year = {2026},
	keywords = {High information density knowledge injection, Knowledge distillation, Large language model, Radiology report generation},
	pages = {129003},
}

@article{huang_medical_2026,
	title = {Medical report generation via knowledge distillation and medical keywords},
	volume = {693},
	issn = {0925-2312},
	url = {https://www.sciencedirect.com/science/article/pii/S0925231226012208},
	doi = {10.1016/j.neucom.2026.133823},
	abstract = {Medical report generation seeks to automatically produce diagnostic narratives from medical imaging data, thereby alleviating radiologists’ workload and improving diagnostic precision. As an emerging task at the intersection of neurocomputing and medical AI, it requires not only robust multimodal understanding but also biologically inspired information processing to mimic the integrative reasoning of expert clinicians. However, current multimodal approaches often fall short in capturing the intricate semantic interplay between visual features and medical text, leading to suboptimal cross-modal alignment and insufficient incorporation of domain-specific knowledge. To address these challenges, we propose a neurocomputing-inspired multimodal signal processing framework that leverages knowledge distillation to bridge the gap between large-scale vision-language models and lightweight, deployment-ready architectures. Specifically, we transfer the global semantic alignment capabilities of models like CLIP into a compact student network, preserving multimodal coherence while significantly reducing computational overhead. To enhance domain relevance, we construct a dynamic, TF-IDF-based medical keyword dictionary that guides the model in learning fine-grained diagnostic terms. A dual-branch decoder, driven by adaptive fusion mechanisms, integrates global visual-textual embeddings with locally salient keyword semantics. Extensive experiments on the IU-Xray and MIMIC-CXR datasets demonstrate that our method achieves state-of-the-art performance, validating its effectiveness and efficiency in clinical neurocomputing environments.},
	urldate = {2026-09-06},
	journal = {Neurocomputing},
	author = {Huang, Lili and Cao, Yiming and Zhao, Xiaowei and Li, Chenglong and Tang, Jin},
	month = sep,
	year = {2026},
	keywords = {Cross-modal alignment, Knowledge distillation, Medical report generation},
	pages = {133823},
}

