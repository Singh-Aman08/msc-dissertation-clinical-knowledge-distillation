	keywords = {Abnormalities, Multiple, Autism Spectrum Disorder, Bone Diseases, Developmental, Chromosome Deletion, DNA Copy Number Variations, Diagnosis, Facies, Genetics, Genetics, Medical, Humans, Intellectual Disability, Male, Pediatrics, Phenotype, Repressor Proteins, Tooth Abnormalities, Transcription Factors},
	pages = {644--654},
}

